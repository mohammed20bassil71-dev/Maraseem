<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>مراسيم | Maraseem – منصة الدعوات الإلكترونية الملكية ثلاثية الأبعاد</title>

  <!-- Open Graph / WhatsApp & Telegram Preview Meta Tags -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="مراسيم | دعوة إلكترونية ملكية ثلاثية الأبعاد ✨" />
  <meta property="og:description" content="يسرنا دعوتكم لمشاركتنا فرحتنا.. اضغط لفتح الدعوة الملكية التفاعلية 3D" />
  <meta property="og:url" content="https://maraseem.ai.studio/" />
  <meta name="theme-color" content="#17130F" />

  <!-- 1. Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- 2. GSAP & ScrollTrigger -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- 3. Three.js -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <!-- 4. Canvas-Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>

  <!-- 5. Google Fonts: Amiri, Cairo, Aref Ruqaa -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Aref+Ruqaa:wght@400;700&family=Cairo:wght@300;400;600;700;800&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            champagne: '#D6B574',
            antiqueGold: '#A98445',
            ivory: '#F8F1E5',
            pearl: '#FFFDF8',
            emeraldRoyal: '#123D32',
            royalBlack: '#17130F',
            royalNavy: '#0B1938',
            blush: '#EBCBC1'
          },
          fontFamily: {
            amiri: ['Amiri', 'serif'],
            cairo: ['Cairo', 'sans-serif'],
            ruqaa: ['Aref Ruqaa', 'serif']
          }
        }
      }
    };
  </script>

  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }
    body {
      font-family: 'Cairo', sans-serif;
      background-color: #F8F1E5;
      color: #17130F;
      overflow-x: hidden;
    }
    .font-amiri { font-family: 'Amiri', serif; }
    .font-ruqaa { font-family: 'Aref Ruqaa', serif; }
    .font-cairo { font-family: 'Cairo', sans-serif; }

    /* Glassmorphism & Luxury Surfaces */
    .royal-glass {
      background: rgba(255, 253, 248, 0.88);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(214, 181, 116, 0.45);
    }
    .royal-dark-glass {
      background: rgba(23, 19, 15, 0.84);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(214, 181, 116, 0.45);
    }
    .gold-border-glow {
      box-shadow: 0 12px 36px -8px rgba(169, 132, 69, 0.25), inset 0 0 18px rgba(214, 181, 116, 0.15);
    }
    .paper-texture {
      background-color: #FFFDF8;
      background-image: radial-gradient(rgba(214, 181, 116, 0.14) 1px, transparent 0);
      background-size: 22px 22px;
    }
    @keyframes pulseHint {
      0%, 100% { transform: translateY(0) scale(1); opacity: 0.92; }
      50% { transform: translateY(-5px) scale(1.03); opacity: 1; }
    }
    .animate-hint {
      animation: pulseHint 2.4s infinite ease-in-out;
    }
    @keyframes soundWave {
      0%, 100% { height: 4px; }
      50% { height: 14px; }
    }
    .wave-bar {
      width: 2.5px;
      background-color: #D6B574;
      border-radius: 99px;
      animation: soundWave 0.9s infinite ease-in-out;
    }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #F8F1E5; }
    ::-webkit-scrollbar-thumb { background: #D6B574; border-radius: 9999px; }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-champagne/30 selection:text-royalBlack">

  <!-- Background Ambient Three.js Canvas -->
  <canvas id="bg-particles-canvas" class="fixed inset-0 w-full h-full pointer-events-none z-0 opacity-45"></canvas>

  <!-- Floating Global Audio Control Button (Appears when MP3 is active) -->
  <button id="floating-audio-btn" onclick="toggleGlobalAudio()" title="كتم / تشغيل الموسيقى"
    class="fixed bottom-5 left-5 z-[60] hidden items-center gap-2 px-4 py-2.5 rounded-full royal-dark-glass text-champagne shadow-2xl border border-champagne hover:scale-105 transition-all cursor-pointer">
    <div id="audio-waves-icon" class="flex items-end gap-0.5 h-3.5">
      <span class="wave-bar" style="animation-delay: 0s;"></span>
      <span class="wave-bar" style="animation-delay: 0.2s;"></span>
      <span class="wave-bar" style="animation-delay: 0.4s;"></span>
    </div>
    <span id="audio-btn-label" class="text-xs font-bold">الموسيقى تعمل</span>
  </button>

  <!-- 1. ROYAL HEADER -->
  <header id="main-app-header" class="sticky top-0 z-40 royal-glass shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
      <button onclick="switchTab('home')" class="flex items-center gap-3 text-right group cursor-pointer">
        <div class="w-11 h-11 rounded-2xl bg-royalBlack border border-champagne flex items-center justify-center shadow-md group-hover:scale-105 transition-transform">
          <span class="font-amiri text-2xl font-bold text-champagne">م</span>
        </div>
        <div>
          <div class="text-2xl font-bold font-amiri text-royalBlack tracking-wide">مراسيم</div>
          <div class="text-[11px] text-antiqueGold font-semibold -mt-1">لكل دعوة حكاية • Royal 3D</div>
        </div>
      </button>

      <nav class="hidden md:flex items-center gap-2 text-xs font-bold">
        <button onclick="switchTab('home')" id="nav-home" class="px-4 py-2.5 rounded-xl bg-royalBlack text-champagne transition-all cursor-pointer">الرئيسية</button>
        <button onclick="switchTab('templates')" id="nav-templates" class="px-4 py-2.5 rounded-xl hover:bg-ivory text-royalBlack/80 transition-all cursor-pointer">استكشف القوالب</button>
        <button onclick="switchTab('graduation')" id="nav-graduation" class="px-4 py-2.5 rounded-xl hover:bg-ivory text-royalBlack/80 transition-all cursor-pointer">مجموعة التخرج 3D</button>
        <button onclick="switchTab('editor')" id="nav-editor" class="px-4 py-2.5 rounded-xl hover:bg-ivory text-royalBlack/80 transition-all cursor-pointer">محرر الدعوات التفاعلي</button>
      </nav>

      <div class="flex items-center gap-2">
        <button onclick="openEditorWithTemplate('tpl-grad-celebration')" class="px-4 py-2.5 rounded-xl bg-royalBlack hover:bg-emeraldRoyal text-champagne border border-champagne/60 font-bold text-xs shadow-sm transition-all cursor-pointer">
          ✨ أنشئ دعوتك 3D
        </button>
      </div>
    </div>

    <!-- Mobile Quick Bar -->
    <div class="flex md:hidden items-center justify-around border-t border-champagne/30 bg-pearl/95 py-2 px-2 text-[11px] font-bold">
      <button onclick="switchTab('home')" class="px-3 py-1.5 rounded-lg text-royalBlack">الرئيسية</button>
      <button onclick="switchTab('templates')" class="px-3 py-1.5 rounded-lg text-royalBlack">القوالب</button>
      <button onclick="switchTab('graduation')" class="px-3 py-1.5 rounded-lg text-antiqueGold">مجموعة التخرج</button>
      <button onclick="switchTab('editor')" class="px-3 py-1.5 rounded-lg text-royalBlack">المحرر 3D</button>
    </div>
  </header>

  <!-- MAIN CONTENT CONTAINER -->
  <main id="main-app-container" class="relative z-10 flex-1">

    <!-- ==================== VIEW 1: HOME ==================== -->
    <section id="view-home" class="pb-20">
      <div class="relative overflow-hidden py-16 sm:py-24 px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="font-amiri text-4xl sm:text-6xl font-bold text-royalBlack leading-tight mb-5">
            مراسيم – لكل دعوة حكاية
          </h1>
          <p class="text-sm sm:text-lg text-royalBlack/75 max-w-2xl mx-auto leading-relaxed mb-8 font-medium">
            منصة الدعوات الإلكترونية الملكية بتجارب افتتاح ثلاثية الأبعاد وموسيقى خاصة؛ حيث يتفاعل ضيوفك مباشرة مع الظرف الملكي، الخاتم الألماسي، قبعة التخرج، أو الفانوس الشرقي.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3.5">
            <button onclick="switchTab('templates')" class="px-8 py-4 rounded-2xl bg-royalBlack hover:bg-emeraldRoyal text-champagne border border-champagne font-bold text-sm shadow-lg transition-all cursor-pointer">
              اكتشف الدعوات
            </button>
            <button onclick="switchTab('graduation')" class="px-7 py-4 rounded-2xl bg-pearl hover:bg-ivory text-royalBlack border border-champagne/60 font-bold text-sm shadow-sm transition-all cursor-pointer">
              🎓 مجموعة التخرج الملكية 3D
            </button>
          </div>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
        <div class="flex flex-wrap items-center justify-center gap-2.5" id="home-category-pills"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div id="home-templates-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7"></div>
      </div>
    </section>

    <!-- ==================== VIEW 2: ALL TEMPLATES ==================== -->
    <section id="view-templates" class="hidden py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="font-amiri text-3xl sm:text-4xl font-bold text-royalBlack mb-3">مكتبة القوالب الملكية ثلاثية الأبعاد</h2>
        <p class="text-xs sm:text-sm text-royalBlack/70">اختر المناسبة واستعرض القوالب التفاعلية، كل قالب يفتتح بمجسم ثلاثي الأبعاد قابل للنقر المباشر مع موسيقى خلفية.</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-2 mb-9" id="gallery-category-pills"></div>
      <div id="gallery-templates-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7"></div>
    </section>

    <!-- ==================== VIEW 3: GRADUATION COLLECTION ==================== -->
    <section id="view-graduation" class="hidden py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <div class="rounded-3xl bg-gradient-to-br from-[#0B1938] via-[#102347] to-[#17130F] p-8 sm:p-12 border border-champagne/50 text-center text-pearl mb-12 shadow-2xl">
        <span class="inline-block px-4 py-1 rounded-full bg-champagne/20 border border-champagne/50 text-champagne text-xs font-bold mb-4">
          GRADUATION ROYAL 3D COLLECTION
        </span>
        <h2 class="font-amiri text-3xl sm:text-5xl font-bold text-champagne mb-4">
          مجموعة التخرج ومشاريع التخرج ثلاثية الأبعاد
        </h2>
        <p class="text-xs sm:text-base text-ivory/85 max-w-2xl mx-auto leading-relaxed">
          قوالب احتفالية متكاملة بهوية الكحلي الملكي والذهبي الشامبين، يُفتتح كل منها بالنقر المباشر على المجسم ثلاثي الأبعاد مع تخصيص مجسم التخصص العلمي.
        </p>
      </div>

      <div id="graduation-collection-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8"></div>
    </section>

    <!-- ==================== VIEW 4: CUSTOMIZATION EDITOR & LIVE 3D PREVIEW ==================== -->
    <section id="view-editor" class="hidden py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- Editor Controls Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="royal-glass rounded-3xl p-6 sm:p-8 gold-border-glow">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-champagne/30 pb-4 mb-6">
              <div>
                <h2 class="font-amiri text-2xl font-bold text-royalBlack">استوديو تخصيص الدعوة الملكية</h2>
                <p class="text-xs text-antiqueGold font-semibold">عدّل البيانات، الموسيقى، وتجربة الافتتاح 3D مع معاينة فورية</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <button onclick="copyShareableGuestLink(this)" class="px-4 py-2.5 rounded-xl bg-emeraldRoyal hover:bg-royalBlack text-champagne border border-champagne font-bold text-xs shadow transition-all cursor-pointer">
                  🔗 نسخ رابط الدعوة للضيوف
                </button>
                <button onclick="launchFullScreenExperience()" class="px-4 py-2.5 rounded-xl bg-royalBlack text-champagne border border-champagne font-bold text-xs shadow hover:bg-antiqueGold hover:text-royalBlack transition-all cursor-pointer">
                  📱 ملء الشاشة
                </button>
              </div>
            </div>

            <!-- 1. Occasion Category -->
            <div class="mb-6">
              <label class="block text-xs font-bold text-royalBlack mb-2">1. نوع المناسبة (Occasion Category)</label>
              <select id="edit-category" onchange="handleEditorCategoryChange(this.value)" class="w-full rounded-xl bg-pearl border border-champagne/60 px-4 py-3 text-sm font-bold text-royalBlack focus:outline-none focus:border-royalBlack">
                <option value="wedding">دعوات الزفاف (Royal Wedding)</option>
                <option value="engagement">دعوات الخطوبة (Engagement)</option>
                <option value="henna">دعوات الحنّة (Henna Night)</option>
                <option value="birthday">أعياد الميلاد (Birthday)</option>
                <option value="graduation">حفلات التخرج (Graduation)</option>
                <option value="graduation_project">مناقشة مشاريع التخرج (Project Graduation)</option>
              </select>
            </div>

            <!-- 2. Opening Experience -->
            <div class="mb-6 p-4 rounded-2xl bg-ivory/80 border border-champagne/50">
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-bold text-royalBlack">2. تجربة الافتتاح ثلاثية الأبعاد (Opening Experience)</label>
                <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-royalBlack text-champagne font-bold">تفاعلي 3D</span>
              </div>
              <p class="text-[11px] text-royalBlack/70 mb-3">
                يتغير المجسم ثلاثي الأبعاد فوراً دون المساس ببيانات الدعوة أو الموسيقى المضافة.
              </p>
              <div id="editor-opening-modes" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>
            </div>

            <!-- 3. Audio & External MP3 Section -->
            <div class="mb-6 p-4 rounded-2xl bg-gradient-to-l from-ivory to-pearl border border-champagne/60 space-y-3">
              <div class="flex items-center justify-between">
                <label class="text-xs font-bold text-royalBlack flex items-center gap-1.5">
                  <span>🎵 3. الموسيقى وملفات MP3 الخارجية</span>
                </label>
                <button type="button" onclick="testEditorAudioPreview()" class="px-3 py-1 rounded-lg bg-royalBlack text-champagne text-[11px] font-bold hover:bg-emeraldRoyal transition-all cursor-pointer">
                  ▶️ تجربة الصوت الآن
                </button>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-[11px] font-bold text-antiqueGold mb-1">موسيقى جاهزة حسب المناسبة:</label>
                  <select id="edit-audio-preset" onchange="handleAudioPresetChange(this.value)" class="w-full rounded-xl bg-pearl border border-champagne/50 px-3 py-2 text-xs font-bold text-royalBlack">
                    <option value="">-- اختر مقطوعة جاهزة أو ضع رابطاً خاصاً --</option>
                    <option value="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3">بيانو رومانسي هادئ (زفاف / خطوبة)</option>
                    <option value="https://cdn.pixabay.com/download/audio/2022/03/15/audio_c8c8a73467.mp3">أوركسترا الفخر الملكية (تخرج / احتفال)</option>
                    <option value="https://cdn.pixabay.com/download/audio/2022/10/25/audio_946bc6eb4c.mp3">أجواء شرقية دافئة (ليلة الحنّة)</option>
                    <option value="https://cdn.pixabay.com/download/audio/2022/01/18/audio_d0a13f69d2.mp3">موسيقى احتفالية مبهجة (عيد ميلاد)</option>
                    <option value="none">بدون موسيقى خلفية (مؤثر اللمس فقط)</option>
                  </select>
                </div>

                <div>
                  <label class="block text-[11px] font-bold text-antiqueGold mb-1">رابط MP3 خارجي مباشر (URL):</label>
                  <input id="edit-audio-url" type="url" placeholder="https://example.com/song.mp3 أو ./music.mp3"
                    oninput="syncEditorField('audioUrl', this.value)"
                    class="w-full rounded-xl bg-pearl border border-champagne/50 px-3 py-2 text-xs text-left" dir="ltr" />
                </div>
              </div>

              <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-champagne/30">
                <label class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-royalBlack hover:bg-emeraldRoyal text-champagne text-xs font-bold cursor-pointer transition-all">
                  <span>📂 رفع ملف MP3 من جهازك (للمعاينة الفورية)</span>
                  <input type="file" accept="audio/mp3,audio/*" class="hidden" onchange="handleLocalMp3Upload(this)" />
                </label>
                <span id="uploaded-mp3-name" class="text-[11px] text-antiqueGold font-bold truncate max-w-[220px]">
                  يعمل تلقائياً عند نقر الضيف على مجسم 3D
                </span>
              </div>
            </div>

            <!-- 4. Dynamic Fields by Category -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
              <div class="sm:col-span-2">
                <label class="block text-xs font-bold text-royalBlack mb-1.5">عنوان الدعوة الرئيسي</label>
                <input id="edit-title" type="text" oninput="syncEditorField('title', this.value)" class="w-full rounded-xl bg-pearl border border-champagne/50 px-3.5 py-2.5 text-sm font-semibold" />
              </div>

              <div>
                <label id="label-primary-name" class="block text-xs font-bold text-royalBlack mb-1.5">الاسم الأول / اسم الخريج</label>
                <input id="edit-primary-name" type="text" oninput="syncEditorField('primaryName', this.value)" class="w-full rounded-xl bg-pearl border border-champagne/50 px-3.5 py-2.5 text-sm font-semibold" />
              </div>

              <div id="wrap-secondary-name">
                <label id="label-secondary-name" class="block text-xs font-bold text-royalBlack mb-1.5">الاسم الثاني / اللقب</label>
                <input id="edit-secondary-name" type="text" oninput="syncEditorField('secondaryName', this.value)" class="w-full rounded-xl bg-pearl border border-champagne/50 px-3.5 py-2.5 text-sm font-semibold" />
              </div>

              <!-- Graduation & Project Specific Fields -->
              <div id="grad-fields-container" class="sm:col-span-2 hidden grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-champagne/30">
                <div>
                  <label class="block text-xs font-bold text-royalBlack mb-1.5">اسم الجامعة</label>
                  <input id="edit-university" type="text" oninput="syncEditorField('university', this.value)" class="w-full rounded-xl bg-pearl border border-champagne/50 px-3.5 py-2.5 text-sm" placeholder="جامعة بغداد" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-royalBlack mb-1.5">الكلية والقسم</label>
                  <input id="edit-college" type="text" oninput="syncEditorField('college', this.value)" class="w-full rounded-xl bg-pearl border border-champagne/50 px-3.5 py-2.5 text-sm" placeholder="كلية الهندسة – قسم العمارة" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-royalBlack mb-1.5">الدرجة العلمية / التقدير</label>
                  <input id="edit-degree" type="text" oninput="syncEditorField('degree', this.value)" class="w-full rounded-xl bg-pearl border border-champagne/50 px-3.5 py-2.5 text-sm" placeholder="بكالوريوس بمرتبة الشرف" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-royalBlack mb-1.5">التخصص الأكاديمي (يغير المجسم العلمي 3D)</label>
                  <select id="edit-major" onchange="handleMajorChange(this.value)" class="w-full rounded-xl bg-pearl border border-champagne/50 px-3.5 py-2.5 text-sm font-bold">
                    <option value="engineering">الهندسة والعمارة (تروس هندسية مذهبة 3D)</option>
                    <option value="medicine">الطب والمختبرات (حلزون DNA مزدوج 3D)</option>
                    <option value="computer">علوم الحاسوب والذكاء الاصطناعي (نواة عصبية 3D)</option>
                    <option value="business">إدارة الأعمال والاقتصاد (أعمدة نمو 3D)</option>
                  </select>
                </div>

                <!-- Optional Graduation Quotes -->
                <div class="sm:col-span-2">
                  <label class="block text-xs font-bold text-antiqueGold mb-2">عبارات تخرج جاهزة (اضغط للاختيار الفوري):</label>
                  <div class="flex flex-wrap gap-2">
