    let isAudioMuted = false;

    function playRoyalChimeAndMP3() {
      // 1. Web Audio API Royal Harp Chime on 3D Touch
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const ctx = new AudioCtx();
        const notes = [523.25, 659.25, 783.99, 1046.50, 1318.51];
        notes.forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.11);
          gain.gain.setValueAtTime(0.14, ctx.currentTime + idx * 0.11);
          gain.gain.exponentialRampToValueAtTime(0.0008, ctx.currentTime + idx * 0.11 + 1.4);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime + idx * 0.11);
          osc.stop(ctx.currentTime + idx * 0.11 + 1.4);
        });
      } catch (e) {}

      // 2. External MP3 Background Track
      const mp3Url = currentInvitation.data.audioUrl;
      const floatingBtn = document.getElementById('floating-audio-btn');
      if (mp3Url && mp3Url !== 'none') {
        if (bgAudioPlayer.src !== mp3Url) {
          bgAudioPlayer.src = mp3Url;
        }
        bgAudioPlayer.muted = isAudioMuted;
        bgAudioPlayer.volume = 0;
        bgAudioPlayer.play().then(() => {
          gsap.to(bgAudioPlayer, { volume: 0.8, duration: 2.2 });
          if (floatingBtn) {
            floatingBtn.classList.remove('hidden');
            floatingBtn.classList.add('flex');
          }
          updateAudioButtonUI();
        }).catch(() => {
          if (floatingBtn) {
            floatingBtn.classList.remove('hidden');
            floatingBtn.classList.add('flex');
          }
        });
      } else {
        bgAudioPlayer.pause();
        if (floatingBtn) floatingBtn.classList.add('hidden');
      }
    }

    function toggleGlobalAudio() {
      if (bgAudioPlayer.paused) {
        isAudioMuted = false;
        bgAudioPlayer.muted = false;
        bgAudioPlayer.play();
      } else {
        isAudioMuted = !isAudioMuted;
        bgAudioPlayer.muted = isAudioMuted;
      }
      updateAudioButtonUI();
    }

    function updateAudioButtonUI() {
      const label = document.getElementById('audio-btn-label');
      const waves = document.getElementById('audio-waves-icon');
      if (!label || !waves) return;
      if (isAudioMuted || bgAudioPlayer.paused) {
        label.textContent = 'تشغيل الموسيقى 🔇';
        waves.classList.add('opacity-30');
      } else {
        label.textContent = 'الموسيقى تعمل 🎵';
        waves.classList.remove('opacity-30');
      }
    }

